{%- macro icon(name, size=20, stroke="currentColor", width=2) -%}
<svg aria-hidden="true" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" stroke="{{ stroke }}" stroke-width="{{ width }}" stroke-linecap="round" stroke-linejoin="round">
{%- if name == "phone" -%}<path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"/>
{%- elif name == "clock" -%}<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>
{%- elif name == "pin" -%}<path d="M12 21s-7-6.5-7-12a7 7 0 0 1 14 0c0 5.5-7 12-7 12z"/><circle cx="12" cy="9" r="2.5"/>
{%- elif name == "calendar" -%}<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/>
{%- elif name == "check" -%}<path d="M5 12l5 5 9-10"/>
{%- elif name == "home" -%}<path d="M3 11l9-7 9 7"/><path d="M5 10v10h14V10"/><path d="M10 20v-6h4v6"/>
{%- elif name == "door" -%}<rect x="6" y="3" width="12" height="18" rx="1"/><circle cx="14.5" cy="12" r="1"/>
{%- elif name == "badge" -%}<circle cx="12" cy="9" r="6"/><path d="M9 9l2 2 4-4"/><path d="M8.5 14.5L7 21l5-3 5 3-1.5-6.5"/>
{%- elif name == "truck" -%}<path d="M2 6h12v10H2z"/><path d="M14 9h4l3 3v4h-7"/><circle cx="6" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/>
{%- elif name == "shield" -%}<path d="M12 3l8 3v6c0 4.5-3.5 8-8 9-4.5-1-8-4.5-8-9V6z"/><path d="M9 12l2 2 4-4"/>
{%- elif name == "menu" -%}<path d="M4 7h16M4 12h16M4 17h16"/>
{%- else -%}<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="4"/><path d="M12 3v5M12 16v5M3 12h5M16 12h5"/>
{%- endif -%}
</svg>
{%- endmacro -%}

{%- macro picture(img, alt="", sizes="100vw", eager=false) -%}
{%- if img -%}
<picture>
{%- for s in img.sources %}<source type="{{ s.type }}" srcset="{{ s.srcset }}" sizes="{{ sizes }}">{% endfor -%}
<img src="{{ img.src }}" srcset="{{ img.srcset }}" sizes="{{ sizes }}" width="{{ img.width }}" height="{{ img.height }}" alt="{{ alt }}" {% if eager %}fetchpriority="high"{% else %}loading="lazy" decoding="async"{% endif %}>
</picture>
{%- endif -%}
{%- endmacro -%}
