{%- set biz = airtable.biz -%}
{%- set q = (biz.Name ~ ' ' ~ biz.Street ~ ' ' ~ biz.City ~ ' ' ~ biz.State ~ ' ' ~ biz.ZIP) | urlencode -%}
<section class="section bg-gray" aria-labelledby="find-h">
<div class="wrap find-row">
<div class="map-box" data-map-src="https://maps.google.com/maps?q={{ q }}&amp;output=embed" data-map-title="Map to {{ biz.Name }}"><noscript><iframe title="Map to {{ biz.Name }}" src="https://maps.google.com/maps?q={{ q }}&amp;output=embed" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe></noscript></div>
<div class="find-us">
<h2 id="find-h" class="h2-sm">Find us</h2>
<p style="font-size: 19px; font-weight: 600;">{{ biz.Street }}<br>{{ biz.City }}, {{ biz.State }} {{ biz.ZIP }}</p>
<p><a class="btn btn-blue btn-small" href="https://www.google.com/maps/search/?api=1&amp;query={{ q }}">Get directions</a></p>
<p><strong>Phone:</strong> <a class="link-strong" href="tel:{{ biz.Phone | tel }}">{{ biz.Phone }}</a></p>
{%- if biz["Toll Free"] %}<p><strong>Toll free:</strong> <a class="link-strong" href="tel:{{ biz['Toll Free'] | tel }}">{{ biz["Toll Free"] }}</a></p>{% endif %}
{%- if biz.Fax %}<p><strong>Fax:</strong> {{ biz.Fax }}</p>{% endif %}
{%- if biz["Public Email"] %}<p><strong>Email:</strong> <a class="link-strong" href="mailto:{{ biz['Public Email'] }}">{{ biz["Public Email"] }}</a></p>{% endif %}
</div>
</div>
</section>
