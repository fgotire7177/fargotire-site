{#- Netlify Form "quote". Netlify reads the fields from this built HTML, so every field must be
    here at build time (no fields added by JavaScript). Same form on Home and Contact. -#}
{%- set biz = airtable.biz -%}
<section id="quote" class="section bg-gray quote" aria-labelledby="quote-h">
<div class="wrap">
<div class="quote-intro">
<h2 id="quote-h">{{ airtable.text.quote_heading }}</h2>
<p>{{ airtable.text.quote_text }}</p>
<p>Rather talk? Call <a class="link-strong" href="tel:{{ biz.Phone | tel }}">{{ biz.Phone }}</a>{% if biz["Toll Free"] %} or toll free <a class="link-strong" href="tel:{{ biz['Toll Free'] | tel }}">{{ biz["Toll Free"] }}</a>{% endif %}.</p>
</div>
<form class="quote-form" name="quote" method="POST" action="/thanks/" data-netlify="true" netlify-honeypot="bot-field" enctype="multipart/form-data">
<input type="hidden" name="form-name" value="quote">
<input type="hidden" name="coupon" value="">
<input type="hidden" name="page" value="">
<p class="bot-field"><label>Leave this empty: <input name="bot-field" tabindex="-1" autocomplete="off"></label></p>
<p class="quote-coupon" hidden>Asking about: <span></span></p>
<div class="field"><label for="q-name">Name</label><input id="q-name" name="name" type="text" autocomplete="name" required></div>
<div class="field"><label for="q-phone">Phone</label><input id="q-phone" name="phone" type="tel" autocomplete="tel"></div>
<div class="field"><label for="q-email">Email</label><input id="q-email" name="email" type="email" autocomplete="email"></div>
<div class="field"><label for="q-need">What do you need?</label>
<select id="q-need" name="need">
<option>Passenger or light truck tires</option>
<option>Semi or commercial tires</option>
<option>Farm or ag tires</option>
<option>Service or repair</option>
<option>On-site service</option>
<option>Just a question</option>
</select></div>
<div class="field"><label for="q-vehicle">Vehicle or equipment</label><input id="q-vehicle" name="vehicle" type="text" placeholder="2019 Ford F-150, JD 8R, etc."></div>
<div class="field"><label for="q-size">Tire size (optional)</label><input id="q-size" name="tire_size" type="text" aria-describedby="q-size-hint"><span class="field-hint" id="q-size-hint">It's printed on the tire's sidewall.</span></div>
<div class="field"><label for="q-qty">How many?</label><input id="q-qty" name="quantity" type="number" min="1" inputmode="numeric"></div>
<div class="field"><label for="q-photo">Sidewall photo (optional)</label><input id="q-photo" name="photo" type="file" accept="image/*"></div>
<div class="field field-wide"><label for="q-msg">Anything else?</label><textarea id="q-msg" name="message" rows="4"></textarea></div>
<fieldset class="field field-wide"><legend>Best way to reach you</legend>
<div class="radio-row">
<label><input type="radio" name="contact_pref" value="Call" checked> Call</label>
<label><input type="radio" name="contact_pref" value="Text"> Text</label>
<label><input type="radio" name="contact_pref" value="Email"> Email</label>
</div></fieldset>
<div class="field-wide"><button class="btn btn-red" type="submit">Send request</button></div>
</form>
</div>
</section>
