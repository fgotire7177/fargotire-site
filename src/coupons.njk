---
layout: layouts/base.njk
title: Tire and Service Specials and Coupons
eleventyComputed:
  description: "Current tire and service specials and coupons at {{ airtable.biz.Name }}, {{ airtable.biz.Street }} in {{ airtable.biz.City }}, {{ airtable.biz.State }}."
---
{%- from "partials/coupons.njk" import couponCard, featuredCard -%}
{%- set biz = airtable.biz -%}
{%- set t = airtable.text -%}
<section class="page-hero bg-blue on-dark">
<div class="wrap"><div>
<h1>Specials &amp; coupons</h1>
<p>{{ t.specials_intro }}</p>
</div></div>
</section>

{%- if airtable.featured.length %}
<section class="section-tight" aria-labelledby="featured-h" data-hide-when-empty>
<div class="wrap">
<h2 id="featured-h" class="h2-sm" style="margin-bottom: 16px;">Featured special</h2>
<div data-coupons data-limit="1">
{%- for c in airtable.featured %}{{ featuredCard(c, biz, site.today) }}{% endfor %}
</div>
</div>
</section>
{%- endif %}

<section class="section-tight" aria-labelledby="all-h">
<div class="wrap">
<h2 id="all-h" class="h2-sm" style="margin-bottom: 16px;">All coupons</h2>
<div class="coupon-row" data-coupons>
{%- for c in airtable.coupons %}{{ couponCard(c, "dashed", biz, site.today) }}{% endfor %}
</div>
<p class="no-coupons"{% if airtable.coupons.length %} hidden{% endif %}>No specials posted right now. Call <a class="link-strong" href="tel:{{ biz.Phone | tel }}">{{ biz.Phone }}</a> for today's deals.</p>
{%- if t.specials_footer %}<p class="lead" style="margin-top: 22px; font-size: 16px;">{{ t.specials_footer }}</p>{% endif %}
</div>
</section>

<section class="cta-band bg-gray">
<div class="wrap">
<div><h2>Need a price on tires?</h2><p>Tell us what you drive or run, and we'll get back to you.</p></div>
<a class="btn btn-red" href="/contact-us/#quote">Request a Quote</a>
</div>
</section>
