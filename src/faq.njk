</div></div>
</section>

<section class="section">
<div class="wrap faq-list">
{%- for f in airtable.faq %}
<div class="faq-item"><h2>{{ f.q }}</h2><div class="prose" style="font-size: 17px;">{{ f.a | md | safe }}</div></div>
{%- endfor %}
</div>
</section>
<script type="application/ld+json">{{ airtable.faqLd | json | safe }}</script>
