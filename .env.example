# Copy to .env for local work. Never commit .env.
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=
# Only needed once, for scripts/airtable-setup.mjs
AIRTABLE_WORKSPACE_ID=
# Netlify build hook URL and a long random key for the Update website button
NETLIFY_BUILD_HOOK_URL=
UPDATE_SITE_KEY=
# Local only: show SAMPLE coupons and holiday rows. Never set on Netlify.
SHOW_SAMPLES=1
# Local only: pretend it's this date/time in Chicago (tests the holiday bar and open-now line)
PREVIEW_DATE=
PREVIEW_TIME=
